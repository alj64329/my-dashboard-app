{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,       
    "lib": ["ES2022","DOM"]   
  },
  "exclude": ["node_modules/**/*"],
  "include": ["src/**/*"]
}